# build output
dist/
.turbo/
# astro generated types
.astro/
# deps
node_modules/
# logs
npm-debug.log*
# secrets: never rely on a personal global gitignore for these.
# .env.schema holds no values and is safe to commit.
.env
.env.*
!.env.schema
# python
__pycache__/
*.pyc
# os / editor
.DS_Store
*.local
.vscode/

# Event media never lives in the repository: camera files, audio, frames,
# chunk transcripts and clips go in $AGNTENG_MEDIA/<date>/ (see
# scripts/common.py). These rules are a safety net for media
# dropped into content/ by mistake.
content/**/raw/
content/**/work/
content/**/upload/
content/**/clips/
*.mp4
*.MP4
*.mov
*.mkv
*.m4v
*.avi
*.wav
*.m4a
*.mp3
