---
// A night's photos in the order they were taken. Each opens full size.
import { Image } from 'astro:assets';
import type { Photo } from '../lib/data';
interface Props { photos: Photo[] }
const { photos } = Astro.props;
---
<ul class="mt-8 grid grid-cols-2 gap-3 md:grid-cols-3">
  {photos.map((p) => (
    <li class="reveal relative aspect-[4/3] overflow-hidden rounded-2xl bg-panel-navy/10 focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-bright-blue">
      <a href={p.img.src} class="group block size-full focus:outline-none">
        <Image src={p.img} alt={p.alt} widths={[480, 960]} sizes="(min-width: 768px) 33vw, 50vw" class="absolute inset-0 size-full object-cover transition duration-500 group-hover:scale-[1.03]" loading="lazy" />
      </a>
    </li>
  ))}
</ul>
