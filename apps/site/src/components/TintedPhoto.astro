---
// A photo in the site's one tint.
import { Image } from 'astro:assets';
interface Props {
  src: ImageMetadata | string;
  alt: string;
  sizes?: string;
  class?: string;
  zoom?: boolean; // grow a little when the enclosing .group is hovered
}
const { src, alt, sizes = '33vw', class: cls, zoom = false } = Astro.props;
const img = ['photo-tint absolute inset-0 size-full object-cover', zoom && 'transition duration-500 group-hover:scale-[1.03]'];
---
<div class:list={['relative overflow-hidden bg-deep-navy', cls]}>
  {typeof src === 'string'
    ? <img src={src} alt={alt} loading="lazy" class:list={img} />
    : <Image src={src} alt={alt} widths={[480, 960]} sizes={sizes} loading="lazy" class:list={img} />}
  <div aria-hidden="true" class="photo-tint-wash pointer-events-none absolute inset-0"></div>
  <slot />
</div>
