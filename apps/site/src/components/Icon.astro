---
// Phosphor icons, inlined at build time so they take currentColor.
import { readFileSync } from 'node:fs';
import { createRequire } from 'node:module';
interface Props { name: string; weight?: 'regular' | 'bold' | 'fill'; class?: string }
const { name, weight = 'regular', class: cls = 'size-5' } = Astro.props;
const file = weight === 'regular' ? `${name}.svg` : `${name}-${weight}.svg`;
const path = createRequire(import.meta.url).resolve(`@phosphor-icons/core/assets/${weight}/${file}`);
const svg = readFileSync(path, 'utf8').replace('<svg', '<svg fill="currentColor"');
---
<span class:list={['inline-block shrink-0 [&>svg]:size-full', cls]} aria-hidden="true" set:html={svg} />
