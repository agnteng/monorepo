---
// Headshot with the brand dither behind the person; the plain photo if there's no mask.
// Preset and animation cycle with the tile's index, so neighbouring tiles differ.
import Animation from '@agnteng/brand/components/Animation.tsx';
import { headshot } from '../lib/data';
import framing from '../speaker-framing.json';
interface Props { src: string; index?: number; class?: string }
const { src, index = 0, class: cls } = Astro.props;
const shot = headshot(src);

// The brand's speaker presets (from the animation builder): the person takes `color`
// as their tint; `bg` is the tile's own background (pattern cells leave it unpainted).
const presets = [
  { color: '#1E2BE6', edge: '#7C4DF5', bg: '#B5A6FF', density: 0.62 },
  { color: '#1E2BE6', edge: '#ED4BA0', bg: '#1FC6E6', density: 0.65 },
  { color: '#3A4DFF', edge: '#B5A6FF', bg: '#FF6E4D', density: 0.65 },
  { color: '#3A4DFF', edge: '#1FC6E6', bg: '#F9C835', density: 0.65 },
  { color: '#B5A6FF', edge: '#1E2BE6', bg: '#7C4DF5', density: 0.65 },
] as const;
const animations = ['aurora', 'drift', 'bloom', 'swarm'] as const;
const { color: tint, edge, bg, density } = presets[index % presets.length];
const animation = animations[(index * 3) % animations.length];

// Every face the same size at the same point (speaker-framing.json). Headshots
// that would end inside the tile are extended by production's extend_headshots.py.
const TILE = framing.tile, FACE = framing.face, AT = framing.at;
let place = 'inset: 0; --mask-size: cover'; // no face: the usual cover crop
if (shot?.face) {
  const [cx, cy, fh] = shot.face;
  const aspect = shot.size[0] / shot.size[1];
  // Photo height in tile heights: the face at its size, or a touch more (at most 5%,
  // which fitness enforces) so the photo covers the tile edge to edge.
  const h = Math.max(FACE / fh, AT / cy, (1 - AT) / (1 - cy), TILE / (2 * aspect * Math.min(cx, 1 - cx)));
  const w = (h * aspect) / TILE;
  const pct = (n: number) => `${(n * 100).toFixed(2)}%`;
  place = `left: ${pct(0.5 - cx * w)}; top: ${pct(AT - cy * h)}; width: ${pct(w)}; height: ${pct(h)}`;
}
---
<div class:list={['relative isolate aspect-square overflow-hidden bg-deep-navy', cls]} style={`--tint: ${tint}${shot ? `; --mask: url(${shot.mask}); background: ${bg}` : ''}`}>
  {shot
    ? <div class="dither-stage absolute inset-0">
        <!-- client:load, not visible: a tile scrolled to after the stage's 1.5s fallback would show its photo first. -->
        <Animation client:load animation={animation} color={tint} edge={edge} cell={4} gap={0} density={density} motion={82} fade="none" shape="square" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
        <div class="absolute" style={place}>
          <img src={src} alt="" loading="lazy" class="speaker-mask speaker-tint absolute inset-0 size-full object-cover" />
          <div aria-hidden="true" class="speaker-mask speaker-tint-wash pointer-events-none absolute inset-0"></div>
        </div>
      </div>
    : <>
        <img src={src} alt="" loading="lazy" class="photo-tint absolute inset-0 size-full object-cover" />
        <div aria-hidden="true" class="photo-tint-wash pointer-events-none absolute inset-0"></div>
      </>}
</div>
