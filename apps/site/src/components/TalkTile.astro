---
// The brand TalkCard, with the talk's own video still when there is one and
// the dither field as its illustration when there isn't.
import Animation from '@agnteng/brand/components/Animation.tsx';
import Avatar from '@agnteng/brand/components/Avatar.astro';
import { thumbnail, shortDate, eventName, type Talk } from '../lib/data';
interface Props { talk: Talk; index?: number }
const { talk, index = 0 } = Astro.props;
const still = thumbnail(talk);
// Vary the dither's fade so a row of talks without video reads as distinct textures.
const fade = (['right', 'left', 'radial', 'up', 'down'] as const)[index % 5];
---
<a href={`/talks/${talk.id}`} class="group flex h-full flex-col overflow-hidden rounded-2xl border border-panel-navy/[0.08] bg-white transition-all duration-200 hover:-translate-y-0.5 hover:shadow-xl hover:shadow-electric-blue/10">
  <div class="relative aspect-video overflow-hidden bg-deep-navy">
    {still
      ? <img src={still} alt="" class="size-full object-cover" loading="lazy" />
      : <Animation client:visible color="#1E2BE6" edge="#B5A6FF" cell={9} density={0.6} fade={fade} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />}
    <span class="absolute bottom-3 right-3 rounded-full bg-deep-navy/80 px-2.5 py-1 font-mono text-[11px] uppercase tracking-wider text-soft-white/80">{eventName(talk.event)} · {shortDate(talk.event.date)}</span>
  </div>
  <div class="flex flex-1 flex-col p-5">
    <h3 class="font-sans text-lg font-bold leading-snug tracking-tight text-panel-navy">{talk.title}</h3>
    <p class="mt-auto flex items-center gap-2.5 pt-5 font-sans text-sm text-panel-navy/60">
      <span aria-hidden="true"><Avatar name={talk.person.name} src={talk.person.photo} size={28} /></span>{talk.person.name}
    </p>
  </div>
</a>
