---
// `overlay` sits on the hero's dither; otherwise the bar is deep navy.
import Button from '@agnteng/brand/components/Button.astro';
import { register } from '../lib/data';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const items = [
  { label: 'Talks', href: '/talks' },
  { label: 'Events', href: '/#events' },
  { label: 'Speakers', href: '/#speakers' },
  { label: 'Newsletter', href: '/#newsletter' },
];
---
<header class:list={['z-20 w-full', overlay ? 'absolute inset-x-0 top-0' : 'border-b border-white/10 bg-deep-navy']}>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/assets/logo/ae-mark-white.svg" alt="Agentic Engineering" class="h-7 w-auto" />
      <img src="/assets/logo/ae-wordmark-white.svg" alt="" class="h-[25px] w-auto" />
    </a>
    <nav class="hidden items-center gap-7 md:flex">
      {items.map((i) => <a href={i.href} class="font-sans text-sm text-soft-white/70 transition-colors hover:text-soft-white">{i.label}</a>)}
    </nav>
    <div class="flex items-center gap-5">
      <a href="/talks" class="font-sans text-sm text-soft-white/70 hover:text-soft-white md:hidden">Talks</a>
      <Button variant="primary" href={register} class="!px-5 !py-2.5 !text-sm">Register</Button>
    </div>
  </div>
</header>
