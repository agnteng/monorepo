---
// `overlay` sits on the hero's dither; otherwise the bar is deep navy.
import Button from '@agnteng/brand/components/Button.astro';
import { register, nextEvent, links } from '../lib/data';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const starts = nextEvent && (nextEvent.luma?.startAt ?? `${nextEvent.date}T23:59:00Z`);
const luma = links.luma;
const items = [
  { label: 'Talks', href: '/talks' },
  { label: 'Events', href: '/#events' },
  { label: 'Speakers', href: '/#speakers' },
  { label: 'Newsletter', href: '/#newsletter' },
];
---
<header class:list={['z-20 w-full', overlay ? 'absolute inset-x-0 top-0' : 'border-b border-white/10 bg-deep-navy']}>
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">
    <a href="/" class="flex items-center gap-2.5">
      <img src="/assets/logo/ae-mark-white.svg" alt="" class="h-7 w-auto" />
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-4 w-auto sm:h-[18px]" />
    </a>
    <nav class="hidden items-center gap-7 md:flex">
      {items.map((i) => <a href={i.href} class="font-sans text-sm text-soft-white/70 transition-colors hover:text-soft-white">{i.label}</a>)}
    </nav>
    <div class="flex items-center gap-5">
      <a href="/talks" class="font-sans text-sm text-soft-white/70 hover:text-soft-white md:hidden">Talks</a>
      <Button variant="primary" href={register} class="js-register !px-5 !py-2.5 !text-sm">Register</Button>
    </div>
  </div>
</header>
<script is:inline define:vars={{ starts, luma }}>
  // The site is rebuilt only on deploy: once the next event has started, every
  // register link and the home page's next-event card point to the Luma calendar.
  if (starts && Date.parse(starts) + 4 * 3600e3 < Date.now()) {
    addEventListener('DOMContentLoaded', () => {
      for (const a of document.querySelectorAll('a.js-register')) {
        a.href = luma;
        a.textContent = 'Follow on Luma';
      }
      const card = document.querySelector('[data-next-event]');
      if (card) card.innerHTML = `<p class="text-sm font-semibold">The next date is on its way.</p><a class="mt-4 inline-flex rounded-full bg-electric-blue px-[26px] py-3.5 font-semibold text-white" href="${luma}">Follow on Luma</a>`;
    });
  }
</script>
