---
// `overlay` sits on the hero's dither; otherwise the bar is deep navy.
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { register, nextEvent, links } from '../lib/data';
interface Props { overlay?: boolean }
const { overlay = false } = Astro.props;
const starts = nextEvent && (nextEvent.luma?.startAt ?? `${nextEvent.date}T23:59:00Z`);
const luma = links.luma;
---
<header class:list={['z-20 w-full', overlay ? 'absolute inset-x-0 top-0' : 'border-b border-white/10 bg-deep-navy']}>
  <div class="mx-auto grid h-16 max-w-7xl grid-cols-[auto_minmax(0,1fr)_auto] items-center gap-4 px-4 md:grid-cols-[1fr_minmax(0,28rem)_1fr] md:gap-8 md:px-8">
    <a href="/" class="flex items-center gap-2.5 justify-self-start">
      <img src="/assets/logo/ae-mark-white.svg" alt="" class="h-7 w-auto" />
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-[18px] w-auto max-sm:hidden" />
    </a>
    <!-- One search box on every page. On /talks it searches in place; elsewhere it carries the search there. -->
    <form action="/talks" role="search" data-search-form class="relative w-full">
      <label for="search" class="sr-only">Search the talks</label>
      <span aria-hidden="true" class="pointer-events-none absolute left-3.5 top-1/2 z-10 -translate-y-1/2 text-soft-white/70"><Icon name="Search" size={16} /></span>
      <input id="search" name="q" type="search" autocomplete="off" spellcheck="false" placeholder="Search talks" aria-keyshortcuts="Meta+K Control+K /" class="peer h-10 w-full rounded-full border border-white/15 bg-white/10 pl-10 pr-10 font-sans text-base text-soft-white outline-none backdrop-blur transition placeholder:text-soft-white/55 focus:border-periwinkle focus:bg-deep-navy/80 md:pr-14 md:text-sm" />
      <kbd aria-hidden="true" data-kbd class="pointer-events-none absolute right-3 top-1/2 hidden -translate-y-1/2 rounded border border-white/20 px-1.5 py-0.5 font-mono text-[10px] text-soft-white/60 peer-focus:hidden peer-[:not(:placeholder-shown)]:hidden md:block">⌘K</kbd>
      <button type="button" data-search-clear aria-label="Clear the search" class="absolute right-2 top-1/2 hidden size-6 -translate-y-1/2 place-items-center rounded-full bg-white/15 text-soft-white transition hover:bg-white/25 peer-[:not(:placeholder-shown)]:grid">
        <svg aria-hidden="true" viewBox="0 0 12 12" class="size-2.5"><path d="M2 2l8 8M10 2l-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
      </button>
    </form>
    <Button variant="primary" href={register} class="js-register justify-self-end !px-5 !py-3 !text-sm md:!py-2.5">Register</Button>
  </div>
</header>
<script is:inline>
  {
    const box = document.getElementById('search');
    const searchPage = location.pathname.replace(/\/$/, '') === '/talks';
    if (!/Mac|iPhone|iPad/.test(navigator.platform)) document.querySelector('[data-kbd]').textContent = 'Ctrl K';
    // Cmd-K always; Ctrl-K and "/" only outside text fields, the search box included
    // (Ctrl-K edits text on macOS, and "/" is a character people search for).
    addEventListener('keydown', (e) => {
      const el = document.activeElement;
      const typing = /^(INPUT|TEXTAREA|SELECT)$/.test(el?.tagName ?? '') || el?.isContentEditable;
      const plain = !e.metaKey && !e.ctrlKey && !e.altKey;
      if ((e.key === '/' && plain && !typing) || (e.key === 'k' && (e.metaKey || (e.ctrlKey && !typing)))) {
        e.preventDefault();
        if (searchPage) { box.focus(); box.select(); } else location.href = '/talks?focus';
      }
    });
    // Off /talks, the search lives on /talks: clicking the box, or typing in it,
    // goes there. Tabbing through the nav doesn't.
    if (!searchPage) {
      box.addEventListener('pointerdown', (e) => { e.preventDefault(); location.href = '/talks?focus'; });
      box.addEventListener('keydown', (e) => {
        if (e.key.length !== 1 || e.metaKey || e.ctrlKey || e.altKey || e.isComposing) return;
        e.preventDefault();
        location.href = `/talks?q=${encodeURIComponent(box.value + e.key)}`;
      });
      box.addEventListener('compositionend', () => { location.href = `/talks?q=${encodeURIComponent(box.value)}`; });
    }
    document.querySelector('[data-search-clear]').addEventListener('click', () => {
      box.value = '';
      box.dispatchEvent(new Event('input', { bubbles: true }));
      box.focus();
    });
  }
</script>
<script is:inline define:vars={{ starts, luma }}>
  // The site is rebuilt only on deploy: once the next event has started, every
  // register link and the home page's next-event card point to the Luma calendar.
  if (starts && Date.parse(starts) + 4 * 3600e3 < Date.now()) {
    addEventListener('DOMContentLoaded', () => {
      for (const a of document.querySelectorAll('a.js-register')) {
        a.href = luma;
        a.textContent = 'Follow on Luma';
      }
      const card = document.querySelector('[data-next-event]');
      if (card) card.innerHTML = `<p class="text-sm font-semibold">The next date is on its way.</p><a class="mt-4 inline-flex rounded-full bg-electric-blue px-[26px] py-3.5 font-semibold text-white" href="${luma}">Follow on Luma</a>`;
    });
  }
</script>
