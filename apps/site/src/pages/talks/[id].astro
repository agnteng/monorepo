---
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import Transcript from '../../components/Transcript.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Avatar from '@agnteng/brand/components/Avatar.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { talks, talksAt, longDate, eventSlug, eventName, type Talk } from '../../lib/data';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}
const { talk } = Astro.props as { talk: Talk };
const e = talk.event;
const more = talksAt(e).filter((t) => t.id !== talk.id);
const linkLists = ([
  [`Find ${talk.person.name.split(' ')[0]}`, talk.speakerLinks],
  ['Mentioned in the talk', talk.mentioned],
] as const).filter(([, list]) => list.length > 0);
---
<Shell title={`${talk.title}, ${talk.person.name} | Agentic Engineering`} description={talk.summary} class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main class="mx-auto max-w-5xl px-4 md:px-8">
    <section class="pt-14 pb-10 md:pt-20">
      <a href={`/events/${eventSlug(e)}`} class="rise inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-electric-blue hover:underline">{eventName(e)}, {longDate(e.date)}</a>
      <h1 class="rise mt-4 max-w-[24ch] font-sans text-3xl font-extrabold leading-[1.1] tracking-tight md:text-5xl" style="--i:1">{talk.title}</h1>
      <div class="rise mt-6 flex items-center gap-3" style="--i:2">
        <Avatar name={talk.person.name} src={talk.person.photo} size={48} />
        <p><span class="font-bold">{talk.person.name}</span>{talk.person.title && <span class="block text-sm text-panel-navy/60">{talk.person.title}</span>}</p>
      </div>
    </section>

    <!-- No .rise here: an animated transform would anchor the floating player to this box. -->
    <div data-video-slot class="relative aspect-video rounded-2xl bg-deep-navy">
      {talk.video
        ? <div data-video class="video-player absolute inset-0 overflow-hidden rounded-2xl bg-deep-navy">
            <iframe class="absolute inset-0 size-full" src={`https://www.youtube-nocookie.com/embed/${talk.video.youtubeId}?enablejsapi=1`} title={talk.title} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
            <button type="button" data-video-close aria-label="Close the mini player" class="absolute right-2 top-2 hidden size-8 place-items-center rounded-full bg-deep-navy/85 text-soft-white hover:bg-deep-navy"><span aria-hidden="true" class="text-xl leading-none">×</span></button>
          </div>
        : <>
            <Animation client:load color="#1E2BE6" edge="#B5A6FF" cell={10} density={0.6} fade="radial" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
            <p class="absolute inset-x-4 bottom-5 mx-auto w-fit rounded-full bg-deep-navy/90 px-4 py-2 text-center font-sans text-xs font-medium text-soft-white/85 md:text-sm">The recording isn't online yet. The write-up and transcript are below.</p>
          </>}
    </div>

    <section class="mx-auto max-w-3xl py-16">
      <p class="text-xl leading-relaxed md:text-2xl">{talk.summary}</p>
      {talk.takeaways.length > 0 && (
        <div class="mt-10 rounded-2xl border border-panel-navy/[0.08] bg-white p-6 md:p-8">
          <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-electric-blue">Main takeaways</h2>
          <ul class="mt-5 space-y-3.5">
            {talk.takeaways.map((k) => <li class="flex gap-3 leading-relaxed"><Icon name="Check" size={16} class="mt-1 shrink-0 text-electric-blue" /><span>{k}</span></li>)}
          </ul>
        </div>
      )}
      {linkLists.length > 0 && (
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {linkLists.map(([heading, list]) => (
            <div><h2 class="font-sans font-bold">{heading}</h2><ul class="mt-3 space-y-2">{list.map((l) => <li><a href={l.url} class="inline-flex items-center gap-2 text-electric-blue hover:underline">{l.label}<Icon name="ExternalLink" size={14} /></a></li>)}</ul></div>
          ))}
        </div>
      )}
      <Transcript talk={talk} class="mt-12 border-y border-panel-navy/15" />
    </section>

    {more.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16">
        <h2 class="font-sans text-2xl font-extrabold">More from {eventName(e)}</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">{more.map((t, i) => <li><TalkTile talk={t} index={i} /></li>)}</ul>
      </section>
    )}
  </main>
  <SiteFooter />

  <script is:inline>
    // Once the video has started, scrolling it out of view docks it in the corner
    // so the transcript can be read alongside. It undocks when the video ends or
    // the mini player is closed, which pauses it.
    const slot = document.querySelector('[data-video-slot]');
    const box = slot?.querySelector('[data-video]');
    if (box) {
      const frame = box.querySelector('iframe');
      const close = box.querySelector('[data-video-close]');
      let started = false, offscreen = false, heard = false;
      const update = () => box.classList.toggle('is-floating', started && offscreen);
      // The YouTube embed reports its state once asked, and may not be ready to
      // hear the first ask: repeat it until it answers. 1 is playing, 0 ended.
      const ask = setInterval(() => {
        if (heard) clearInterval(ask);
        else frame.contentWindow.postMessage('{"event":"listening"}', '*');
      }, 500);
      setTimeout(() => clearInterval(ask), 15000);
      addEventListener('message', (m) => {
        if (m.source !== frame.contentWindow) return;
        heard = true;
        try {
          const state = JSON.parse(m.data)?.info?.playerState;
          if (state === 1) started = true;
          if (state === 0) started = false;
          update();
        } catch {}
      });
      new IntersectionObserver(([e]) => { offscreen = e.intersectionRatio < 0.25; update(); }, { threshold: [0, 0.25] }).observe(slot);
      close.addEventListener('click', () => {
        frame.contentWindow.postMessage('{"event":"command","func":"pauseVideo","args":""}', '*');
        started = false; update();
      });
    }
  </script>
</Shell>
