---
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import Transcript from '../../components/Transcript.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Avatar from '@agnteng/brand/components/Avatar.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { talks, talksAt, longDate, eventSlug, eventName, type Talk } from '../../lib/data';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}
const { talk } = Astro.props as { talk: Talk };
const e = talk.event;
const more = talksAt(e).filter((t) => t.id !== talk.id);
const linkLists = ([
  [`Find ${talk.person.name.split(' ')[0]}`, talk.speakerLinks],
  ['Mentioned in the talk', talk.mentioned],
] as const).filter(([, list]) => list.length > 0);
---
<Shell title={`${talk.title}, ${talk.person.name} | Agentic Engineering`} description={talk.summary} class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main class="mx-auto max-w-5xl px-4 md:px-8">
    <section class="pt-14 pb-10 md:pt-20">
      <a href={`/events/${eventSlug(e)}`} class="rise inline-flex items-center gap-2 font-mono text-xs uppercase tracking-wider text-electric-blue hover:underline">{eventName(e)}, {longDate(e.date)}</a>
      <h1 class="rise mt-4 max-w-[24ch] font-mono text-3xl font-semibold leading-[1.1] tracking-tight md:text-5xl" style="--i:1">{talk.title}</h1>
      <div class="rise mt-6 flex items-center gap-3" style="--i:2">
        <Avatar name={talk.person.name} src={talk.person.photo} size={48} />
        <p><span class="font-bold">{talk.person.name}</span>{talk.person.title && <span class="block text-sm text-panel-navy/60">{talk.person.title}</span>}</p>
      </div>
    </section>

    <div class="rise relative aspect-video overflow-hidden rounded-2xl bg-deep-navy" style="--i:3">
      {talk.video
        ? <iframe class="absolute inset-0 size-full" src={`https://www.youtube-nocookie.com/embed/${talk.video.youtubeId}`} title={talk.title} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        : <>
            <Animation client:load color="#1E2BE6" edge="#B5A6FF" cell={10} density={0.6} fade="radial" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
            <p class="absolute inset-x-4 bottom-5 mx-auto w-fit rounded-full bg-deep-navy/90 px-4 py-2 text-center font-mono text-xs text-soft-white/85 md:text-sm">The recording isn't online yet. The write-up and transcript are below.</p>
          </>}
    </div>

    <section class="mx-auto max-w-3xl py-16">
      <p class="text-xl leading-relaxed md:text-2xl">{talk.summary}</p>
      {talk.takeaways.length > 0 && (
        <div class="mt-10 rounded-2xl border border-panel-navy/[0.08] bg-white p-6 md:p-8">
          <h2 class="font-mono text-sm font-semibold uppercase tracking-wider text-electric-blue">Main takeaways</h2>
          <ul class="mt-5 space-y-3.5">
            {talk.takeaways.map((k) => <li class="flex gap-3 leading-relaxed"><Icon name="Check" size={16} class="mt-1 shrink-0 text-electric-blue" /><span>{k}</span></li>)}
          </ul>
        </div>
      )}
      {linkLists.length > 0 && (
        <div class="mt-10 grid gap-8 sm:grid-cols-2">
          {linkLists.map(([heading, list]) => (
            <div><h2 class="font-mono font-semibold">{heading}</h2><ul class="mt-3 space-y-2">{list.map((l) => <li><a href={l.url} class="inline-flex items-center gap-2 text-electric-blue hover:underline">{l.label}<Icon name="ExternalLink" size={14} /></a></li>)}</ul></div>
          ))}
        </div>
      )}
      <Transcript talk={talk} class="mt-12 border-y border-panel-navy/15" />
    </section>

    {more.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16">
        <h2 class="font-mono text-2xl font-semibold">Also that night</h2>
        <ul class="mt-8 grid gap-5 sm:grid-cols-2">{more.map((t, i) => <li><TalkTile talk={t} index={i} /></li>)}</ul>
      </section>
    )}
  </main>
  <SiteFooter />
</Shell>
