---
// Every talk in one archive, newest first. The nav's search box searches titles,
// speakers, summaries and transcripts here (src/lib/search.js over /search.json); the
// meetup chips narrow it. Search filters and reorders the same grid of cards,
// each showing the moment the words were said. ?q= and ?meetup= are shareable.
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import { talks, events, talksAt, eventName } from '../../lib/data';
const meetups = events.filter((e) => talksAt(e).length).sort((a, b) => b.date.localeCompare(a.date)).map(eventName);
const chip = 'rounded-full border-[1.5px] border-panel-navy/15 px-4 py-2 font-sans text-sm font-semibold text-panel-navy/75 transition hover:border-electric-blue hover:text-electric-blue aria-pressed:border-electric-blue aria-pressed:bg-electric-blue aria-pressed:text-white';
---
<Shell title="Talks | Agentic Engineering" description="Every talk from Agentic Engineering, searchable down to the transcript." class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main id="main" class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="font-sans text-4xl font-extrabold tracking-tight md:text-6xl">Talks</h1>


    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Meetup">
      <button type="button" class={chip} data-meetup="" aria-pressed="true">All</button>
      {meetups.map((m) => <button type="button" class={chip} data-meetup={m} aria-pressed="false">{m}</button>)}
    </div>

    <p data-search-status aria-live="polite" class="mt-8 min-h-6 font-sans text-sm text-panel-navy/60"></p>

    <!-- Search filters and reorders this grid in place; nothing switches layout. -->
    <ul data-talk-grid class="mt-2 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {talks.map((t, i) => <li data-meetup={eventName(t.event)} data-path={`/talks/${t.id}`} data-order={i}><TalkTile talk={t} index={i} /></li>)}
    </ul>
    <div data-empty hidden class="mt-6 rounded-2xl border border-dashed border-panel-navy/15 px-6 py-12 text-center">
      <p class="font-sans text-lg font-bold" aria-hidden="true">No talk mentions that.</p>
      <p class="mt-2 text-panel-navy/65">Try a speaker’s name, a tool or a company.</p>
    </div>
  </main>
  <SiteFooter />

  <script>
    import { search } from '../../lib/search.js';

    const input = document.getElementById('search') as HTMLInputElement;
    const form = document.querySelector('[data-search-form]')!;
    const status = document.querySelector('[data-search-status]')!;
    const grid = document.querySelector('[data-talk-grid]')!;
    const empty = document.querySelector('[data-empty]') as HTMLElement;
    const chips = [...document.querySelectorAll<HTMLElement>('[data-meetup][aria-pressed]')];
    const cards = [...grid.children] as HTMLElement[];
    const params = new URLSearchParams(location.search);
    let meetup = params.get('meetup') ?? '';
    input.value = params.get('q') ?? '';
    if (params.has('focus') || params.has('q')) {
      input.focus({ preventScroll: true });
      input.setSelectionRange(input.value.length, input.value.length);
    }

    let index: Promise<any[]> | undefined;
    const load = () => (index ??= fetch('/search.json').then((r) => r.json()));
    input.addEventListener('focus', load, { once: true });

    // Show `hits` (path → { url, snippet }) in their order; null shows every talk as it was.
    const show = (hits: Map<string, { url: string; snippet: string }> | null) => {
      const order = hits ? [...hits.keys()] : null;
      for (const li of cards) {
        const hit = hits?.get(li.dataset.path!);
        const a = li.querySelector('a')!, snip = li.querySelector('[data-snippet]') as HTMLElement;
        li.hidden = (!!meetup && li.dataset.meetup !== meetup) || (!!hits && !hit);
        a.href = hit?.url ?? li.dataset.path!;
        snip.hidden = !hit?.snippet;
        snip.innerHTML = hit?.snippet ?? '';
      }
      // Move the cards themselves, so tab order follows what's on screen.
      const rank = (li: HTMLElement) => (order ? order.indexOf(li.dataset.path!) : 0) * 1000 + Number(li.dataset.order);
      grid.append(...[...cards].sort((x, y) => rank(x) - rank(y)));
      const shown = cards.filter((li) => !li.hidden).length;
      empty.hidden = shown > 0;
      return shown;
    };

    let run = 0;
    const update = async () => {
      const mine = ++run;
      const q = input.value.trim();
      const url = new URL(location.href);
      url.searchParams.delete('focus');
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      meetup ? url.searchParams.set('meetup', meetup) : url.searchParams.delete('meetup');
      history.replaceState(null, '', url);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.meetup === meetup)));
      if (!q) {
        const n = show(null);
        status.textContent = meetup ? `${n} ${n === 1 ? 'talk' : 'talks'} from ${meetup}` : '';
        return;
      }
      const hits = search(await load(), q);
      if (mine !== run) return;
      const n = show(new Map(hits.map((h) => [h.path, h])));
      status.textContent = n
        ? `${n} ${n === 1 ? 'talk' : 'talks'} for “${q}”${meetup ? ` from ${meetup}` : ''}`
        : `No talk mentions “${q}”${meetup ? ` from ${meetup}` : ''}.`;
    };

    let wait: ReturnType<typeof setTimeout>;
    input.addEventListener('input', () => { clearTimeout(wait); wait = setTimeout(update, 80); });
    form.addEventListener('submit', (e) => { e.preventDefault(); update(); });
    chips.forEach((c) => c.addEventListener('click', () => { meetup = c.dataset.meetup!; update(); }));
    update();
  </script>
</Shell>
