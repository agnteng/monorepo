---
// Every talk in one archive, newest first. The nav's search box searches titles,
// speakers, summaries and transcripts here (Pagefind, built with the site); the
// meetup chips narrow either view. ?q= and ?meetup= make both shareable.
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import { talks, events, talksAt, eventName } from '../../lib/data';
const meetups = events.filter((e) => talksAt(e).length).sort((a, b) => b.date.localeCompare(a.date)).map(eventName);
const chip = 'rounded-full border-[1.5px] border-panel-navy/15 px-4 py-2 font-sans text-sm font-semibold text-panel-navy/75 transition hover:border-electric-blue hover:text-electric-blue aria-pressed:border-electric-blue aria-pressed:bg-electric-blue aria-pressed:text-white';
---
<Shell title="Talks | Agentic Engineering" description="Every talk from Agentic Engineering, searchable down to the transcript." class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="font-sans text-4xl font-extrabold tracking-tight md:text-6xl">Talks</h1>


    <div class="mt-8 flex flex-wrap gap-2" role="group" aria-label="Meetup">
      <button type="button" class={chip} data-meetup="" aria-pressed="true">All</button>
      {meetups.map((m) => <button type="button" class={chip} data-meetup={m} aria-pressed="false">{m}</button>)}
    </div>

    <p data-search-status aria-live="polite" class="mt-8 min-h-6 font-sans text-sm text-panel-navy/60"></p>
    <ol data-search-results hidden class="mt-2 divide-y divide-panel-navy/10"></ol>

    <ul data-talk-grid class="mt-2 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {talks.map((t, i) => <li data-meetup={eventName(t.event)}><TalkTile talk={t} index={i} /></li>)}
    </ul>
  </main>
  <SiteFooter />

  <script type="module" is:inline>
    const input = document.getElementById('search');
    const form = document.querySelector('[data-search-form]');
    const status = document.querySelector('[data-search-status]');
    const list = document.querySelector('[data-search-results]');
    const grid = document.querySelector('[data-talk-grid]');
    const chips = [...document.querySelectorAll('[data-meetup][aria-pressed]')];
    const params = new URLSearchParams(location.search);
    let meetup = params.get('meetup') ?? '';
    input.value = params.get('q') ?? '';
    if (location.hash === '#search' || params.has('q')) {
      input.focus();
      input.setSelectionRange(input.value.length, input.value.length);
    }
    addEventListener('hashchange', () => location.hash === '#search' && input.focus());

    const esc = (s) => String(s ?? '').replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' })[c]);
    let pagefind;
    const load = async () => {
      // Built with the site (`pagefind --site dist`), so it is missing under `astro dev`.
      try { pagefind ??= await import('/pagefind/pagefind.js'); } catch { pagefind = null; }
      return pagefind;
    };

    const row = (r) => {
      const moments = r.sub_results.filter((s) => /#t-\d+$/.test(s.url)).slice(0, 2);
      return `<li class="py-6"><a href="${esc(r.url)}" class="group grid gap-5 sm:grid-cols-[12rem_1fr]">
        ${r.meta.image ? `<img src="${esc(r.meta.image)}" alt="" loading="lazy" class="aspect-video w-full rounded-xl object-cover">` : '<span></span>'}
        <span>
          <span class="block font-mono text-[11px] uppercase tracking-wider text-electric-blue">${esc(r.meta.date)}</span>
          <span class="mt-1 block font-sans text-xl font-bold leading-snug group-hover:text-electric-blue">${esc(r.meta.title)}</span>
          <span class="mt-0.5 block text-sm text-panel-navy/60">${esc(r.meta.speaker)}</span>
          <span class="search-excerpt mt-3 block leading-relaxed text-panel-navy/80">${r.excerpt}</span>
        </span></a>
        ${moments.map((s) => `<a href="${esc(s.url)}" class="search-excerpt mt-3 grid gap-3 rounded-lg px-3 py-2 text-sm leading-relaxed text-panel-navy/75 hover:bg-white sm:ml-[13.25rem] sm:grid-cols-[3.5rem_1fr]"><span class="font-mono text-electric-blue">${esc(s.title)}</span><span>${s.excerpt}</span></a>`).join('')}
      </li>`;
    };

    let run = 0;
    const update = async () => {
      const mine = ++run; // a newer update makes any search still in flight stale
      const q = input.value.trim();
      const url = new URL(location.href);
      q ? url.searchParams.set('q', q) : url.searchParams.delete('q');
      meetup ? url.searchParams.set('meetup', meetup) : url.searchParams.delete('meetup');
      history.replaceState(null, '', url);
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c.dataset.meetup === meetup)));

      if (!q) {
        list.hidden = true;
        grid.hidden = false;
        let shown = 0;
        for (const li of grid.children) { li.hidden = !!meetup && li.dataset.meetup !== meetup; shown += !li.hidden; }
        status.textContent = meetup ? `${shown} talks from ${meetup}` : '';
        return;
      }
      let found, data;
      try {
        const pf = await load();
        if (!pf) throw new Error('no index');
        found = await pf.search(q, { filters: meetup ? { meetup } : {} });
        data = await Promise.all(found.results.slice(0, 20).map((r) => r.data()));
      } catch {
        if (mine === run) status.textContent = 'Search isn’t available right now. The full list is below.';
        list.hidden = true;
        grid.hidden = false;
        return;
      }
      if (mine !== run) return;
      grid.hidden = true;
      list.hidden = false;
      list.innerHTML = data.map(row).join('');
      const n = found.results.length;
      status.textContent = n ? `${n} ${n === 1 ? 'talk' : 'talks'} for “${q}”${meetup ? ` at ${meetup}` : ''}` : `Nothing for “${q}”${meetup ? ` at ${meetup}` : ''}. Try a speaker, a tool or a company.`;
    };

    let wait;
    input.addEventListener('input', () => { clearTimeout(wait); wait = setTimeout(update, 180); });
    form.addEventListener('submit', (e) => { e.preventDefault(); update(); });
    chips.forEach((c) => c.addEventListener('click', () => { meetup = c.dataset.meetup; update(); }));
    update();
  </script>
</Shell>
