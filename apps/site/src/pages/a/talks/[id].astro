---
import Shell from '../../../layouts/Shell.astro';
import Icon from '../../../components/Icon.astro';
import Transcript from '../../../components/Transcript.astro';
import { talks, talksAt, shortDate, socials, type Talk } from '../../../lib/data';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}
const { talk } = Astro.props as { talk: Talk };
const e = talk.event;
const more = talksAt(e).filter((t) => t.id !== talk.id);
---
<Shell title={`${talk.title}, ${talk.person.name} | Agentic Engineering`} description={talk.summary} class="bg-soft-white text-deep-navy">
  <header class="border-b border-deep-navy/10">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">
      <a href="/a"><img src="/assets/logo/ae-wordmark-line.svg" alt="Agentic Engineering" class="h-5 md:h-6" /></a>
      <a href="/a#talks" class="flex items-center gap-2 text-sm font-semibold hover:text-electric-blue"><Icon name="arrow-left" class="size-4" />All talks</a>
    </nav>
  </header>

  <main class="mx-auto max-w-7xl px-4 md:px-8">
    <section class="grid gap-10 pt-12 pb-10 md:grid-cols-12 md:pt-20">
      <div class="md:col-span-8">
        <p class="rise font-mono text-sm font-semibold" style="--i:0">{e.city} #{e.number}, {shortDate(e.date)}</p>
        <h1 class="rise mt-4 font-mono text-3xl font-semibold leading-[1.1] tracking-tight md:text-5xl" style="--i:1">{talk.title}</h1>
      </div>
      <div class="rise flex items-center gap-4 md:col-span-4 md:self-end" style="--i:2">
        {talk.person.photo && <img src={talk.person.photo} alt="" class="size-16 object-cover" />}
        <div>
          <p class="font-bold">{talk.person.name}</p>
          {talk.person.title && <p class="text-sm text-deep-navy/60">{talk.person.title}</p>}
          {talk.speakerLinks.length > 0 && (
            <p class="mt-1 flex gap-3 text-sm font-semibold">{talk.speakerLinks.map((l) => <a href={l.url} class="text-electric-blue hover:underline">{l.label}</a>)}</p>
          )}
        </div>
      </div>
    </section>

    <div class="rise aspect-video w-full border-2 border-deep-navy bg-deep-navy" style="--i:3">
      {talk.video
        ? <iframe class="size-full" src={`https://www.youtube-nocookie.com/embed/${talk.video.youtubeId}`} title={talk.title} loading="lazy" allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
        : <div class="flex size-full flex-col items-center justify-center gap-3 text-soft-white/70"><Icon name="film-slate" class="size-10" /><p class="font-mono text-sm">The video for this talk is not online yet.</p></div>}
    </div>

    <section class="grid gap-12 py-16 md:grid-cols-12">
      <div class="md:col-span-8">
        <p class="text-xl leading-relaxed md:text-2xl">{talk.summary}</p>
        {talk.takeaways.length > 0 && (
          <ol class="mt-10 space-y-5">
            {talk.takeaways.map((k, i) => (
              <li class="grid grid-cols-[2.5rem_1fr] gap-2 text-lg leading-relaxed">
                <span class="font-mono font-bold text-electric-blue">{String(i + 1).padStart(2, '0')}</span><span>{k}</span>
              </li>
            ))}
          </ol>
        )}
        <Transcript talk={talk} class="mt-12 border-y-2 border-deep-navy" />
      </div>
      {talk.mentioned.length > 0 && (
        <aside class="md:col-span-4">
          <h2 class="font-mono text-sm font-semibold">Mentioned in the talk</h2>
          <ul class="mt-4 divide-y divide-deep-navy/15 border-t-2 border-deep-navy">
            {talk.mentioned.map((l) => (
              <li><a href={l.url} class="group flex items-center justify-between gap-4 py-3 font-medium hover:text-electric-blue">{l.label}<Icon name="arrow-up-right" class="size-4" /></a></li>
            ))}
          </ul>
        </aside>
      )}
    </section>

    {more.length > 0 && (
      <section class="border-t-2 border-deep-navy py-16">
        <h2 class="font-mono text-2xl font-semibold">Also that night</h2>
        <div class="mt-8 grid gap-8 md:grid-cols-2">
          {more.map((t) => (
            <a href={`/a/talks/${t.id}`} class="group flex gap-5">
              {t.person.photo && <img src={t.person.photo} alt="" class="size-20 object-cover grayscale transition group-hover:grayscale-0" loading="lazy" />}
              <div><p class="text-xl font-bold leading-snug group-hover:text-electric-blue">{t.title}</p><p class="mt-1 text-sm text-deep-navy/60">{t.person.name}</p></div>
            </a>
          ))}
        </div>
      </section>
    )}
  </main>

  <footer class="bg-deep-navy text-soft-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-8">
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5" />
      <ul class="flex flex-wrap gap-6 text-sm font-semibold">{socials.map((s) => <li><a href={s.url} class="hover:text-periwinkle">{s.label}</a></li>)}</ul>
    </div>
  </footer>
</Shell>
