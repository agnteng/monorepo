---
// Direction A, "Index": light and typographic. The next event's date is the
// hero; talks read as a programme, grouped by night.
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import { nextEvent, past, talks, talksAt, speakers, agenda, socials, day, month, shortDate } from '../../lib/data';

const register = nextEvent?.luma?.url ?? 'https://luma.com/agnteng';
const nights = past.filter((e) => talksAt(e).length);
const year = (d: string) => d.slice(0, 4);
---
<Shell title="Agentic Engineering" class="bg-soft-white text-deep-navy">
  <header class="sticky top-0 z-20 border-b border-deep-navy/10 bg-soft-white/90 backdrop-blur">
    <nav class="mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">
      <a href="/a" class="flex items-center"><img src="/assets/logo/ae-wordmark-line.svg" alt="Agentic Engineering" class="h-5 md:h-6" /></a>
      <div class="flex items-center gap-6 text-sm font-semibold">
        <a href="#talks" class="hidden hover:text-electric-blue md:block">Talks</a>
        <a href="#speakers" class="hidden hover:text-electric-blue md:block">Speakers</a>
        <a href="#events" class="hidden hover:text-electric-blue md:block">Events</a>
        <a href="#involved" class="hidden hover:text-electric-blue md:block">Get involved</a>
        <a href={register} class="bg-electric-blue px-4 py-2 text-soft-white transition hover:bg-bright-blue active:translate-y-px">Register</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="mx-auto grid max-w-7xl gap-12 px-4 pt-14 pb-20 md:grid-cols-12 md:px-8 md:pt-24 md:pb-28">
      <div class="md:col-span-7">
        <h1 class="rise font-mono text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl" style="--i:0">
          A Lisbon meetup for people building with agents.
        </h1>
        <p class="rise mt-6 max-w-[52ch] text-lg leading-relaxed text-deep-navy/70" style="--i:1">
          Three short talks from people shipping with AI agents, then questions and drinks. No product pitches.
        </p>
        <div class="rise mt-9 flex flex-wrap gap-3" style="--i:2">
          <a href={register} class="bg-electric-blue px-6 py-3.5 font-semibold text-soft-white transition hover:bg-bright-blue active:translate-y-px">Register</a>
          <a href="#talks" class="border-2 border-deep-navy px-6 py-3 font-semibold transition hover:bg-deep-navy hover:text-soft-white active:translate-y-px">Watch the talks</a>
        </div>
      </div>

      {nextEvent && (
        <a href={register} class="rise group block border-2 border-deep-navy md:col-span-5 md:self-end" style="--i:3">
          <div class="flex items-center justify-between border-b-2 border-deep-navy px-5 py-3 font-mono text-sm">
            <span>Next: {nextEvent.city} #{nextEvent.number}</span>
            <Icon name="arrow-up-right" class="size-5 transition group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
          </div>
          <div class="flex items-end gap-4 px-5 pt-4 pb-5">
            <span class="font-mono text-[7.5rem] font-bold leading-[0.8] text-electric-blue md:text-[9rem]">{day(nextEvent.date)}</span>
            <span class="pb-1 font-mono text-2xl font-semibold uppercase leading-tight">{month(nextEvent.date)}<br />{year(nextEvent.date)}</span>
          </div>
          <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5 border-t-2 border-deep-navy px-5 py-4 text-sm">
            {agenda.map((a) => (<><dt class="font-mono text-deep-navy/60">{a.time}</dt><dd class="font-medium">{a.what}</dd></>))}
            <dt class="font-mono text-deep-navy/60">Where</dt><dd class="font-medium">{nextEvent.venue}</dd>
          </dl>
        </a>
      )}
    </section>

    <section id="talks" class="border-t border-deep-navy/10">
      <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
        <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">Talks</h2>
        <p class="mt-4 max-w-[60ch] text-deep-navy/70">{talks.length} talks so far, each with its video, a summary and the full transcript.</p>

        <div class="mt-14 space-y-16">
          {nights.map((e) => (
            <div class="reveal grid gap-6 md:grid-cols-12">
              <div class="md:col-span-3">
                <p class="font-mono text-sm font-semibold">{e.city} #{e.number}</p>
                <p class="mt-1 text-sm text-deep-navy/60">{shortDate(e.date)}<br />{e.venue}</p>
              </div>
              <ol class="md:col-span-9">
                {talksAt(e).map((t) => (
                  <li>
                    <a href={`/a/talks/${t.id}`} class="group grid grid-cols-[1fr_auto] items-center gap-6 border-t border-deep-navy/15 py-6 first:border-t-2 first:border-deep-navy">
                      <div>
                        <p class="text-xl font-bold leading-snug transition group-hover:text-electric-blue md:text-3xl md:leading-tight">{t.title}</p>
                        <p class="mt-2 text-sm text-deep-navy/60">{t.person.name}{t.person.title && `, ${t.person.title}`}</p>
                      </div>
                      <div class="flex items-center gap-4">
                        {t.video && <span class="hidden items-center gap-1.5 font-mono text-xs md:flex"><Icon name="play" weight="fill" class="size-3.5" />Video</span>}
                        {t.person.photo
                          ? <img src={t.person.photo} alt="" class="size-14 object-cover grayscale transition group-hover:grayscale-0 md:size-16" loading="lazy" />
                          : <span class="size-14 md:size-16" />}
                      </div>
                    </a>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section id="speakers" class="bg-deep-navy text-soft-white">
      <div class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
        <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">Speakers</h2>
        <ul class="mt-12 grid grid-cols-2 gap-x-6 gap-y-10 sm:grid-cols-3 lg:grid-cols-6">
          {speakers.map((s) => (
            <li class="reveal">
              <a href={`/a/talks/${s.talks[0].id}`} class="group block">
                {s.photo
                  ? <img src={s.photo} alt={s.name} class="aspect-[4/5] w-full object-cover grayscale transition duration-500 group-hover:grayscale-0" loading="lazy" />
                  : <div class="aspect-[4/5] w-full bg-panel-navy" />}
                <p class="mt-3 font-semibold leading-tight">{s.name}</p>
                {s.title && <p class="mt-1 text-sm text-soft-white/60">{s.title}</p>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section id="events" class="mx-auto max-w-7xl px-4 py-20 md:px-8 md:py-28">
      <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">Every night so far</h2>
      <div class="mt-12 grid gap-px bg-deep-navy/15 sm:grid-cols-2 lg:grid-cols-4">
        {past.map((e) => (
          <a href={e.luma?.url ?? '#'} class="reveal group bg-soft-white p-6 transition hover:bg-white">
            <p class="font-mono text-5xl font-bold text-electric-blue">#{e.number}</p>
            <p class="mt-6 font-semibold">{shortDate(e.date)}</p>
            <p class="text-sm text-deep-navy/60">{e.venue}</p>
            <p class="mt-4 text-sm">{talksAt(e).length ? `${talksAt(e).length} talks` : 'Talks not online yet'}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="involved" class="border-t border-deep-navy/10">
      <div class="mx-auto grid max-w-7xl gap-12 px-4 py-20 md:grid-cols-12 md:px-8 md:py-28">
        <h2 class="font-mono text-3xl font-semibold leading-tight tracking-tight md:col-span-5 md:text-5xl">Speak, host or sponsor the next one.</h2>
        <div class="divide-y divide-deep-navy/15 border-y-2 border-deep-navy md:col-span-7">
          <a href={register} class="group flex items-start justify-between gap-6 py-6">
            <div><p class="text-xl font-bold">Give a talk</p><p class="mt-1 max-w-[50ch] text-deep-navy/70">Register for the next event and fill in the talk field. Ten minutes, real work, no pitches.</p></div>
            <Icon name="arrow-right" class="mt-1 size-6 transition group-hover:translate-x-1" />
          </a>
          <a href="https://t.me/agntacc" class="group flex items-start justify-between gap-6 py-6">
            <div><p class="text-xl font-bold">Host a night</p><p class="mt-1 max-w-[50ch] text-deep-navy/70">Have a room in Lisbon? Tell us on Telegram.</p></div>
            <Icon name="arrow-right" class="mt-1 size-6 transition group-hover:translate-x-1" />
          </a>
          <a href="https://sponsors.agnteng.com" class="group flex items-start justify-between gap-6 py-6">
            <div><p class="text-xl font-bold">Sponsor</p><p class="mt-1 max-w-[50ch] text-deep-navy/70">Put your team in front of the people building with agents in Lisbon.</p></div>
            <Icon name="arrow-right" class="mt-1 size-6 transition group-hover:translate-x-1" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <footer class="bg-deep-navy text-soft-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-8">
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5" />
      <ul class="flex flex-wrap gap-6 text-sm font-semibold">
        {socials.map((s) => <li><a href={s.url} class="hover:text-periwinkle">{s.label}</a></li>)}
      </ul>
    </div>
  </footer>
</Shell>
