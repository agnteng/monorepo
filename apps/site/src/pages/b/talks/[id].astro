---
import Shell from '../../../layouts/Shell.astro';
import Icon from '../../../components/Icon.astro';
import Transcript from '../../../components/Transcript.astro';
import { talks, shortDate, socials, thumbnail, type Talk } from '../../../lib/data';

export function getStaticPaths() {
  return talks.map((talk) => ({ params: { id: talk.id }, props: { talk } }));
}
const { talk } = Astro.props as { talk: Talk };
const e = talk.event;
const next = talks.filter((t) => t.id !== talk.id).slice(0, 3);
---
<Shell title={`${talk.title}, ${talk.person.name} | Agentic Engineering`} description={talk.summary} class="bg-deep-navy text-soft-white">
  <header>
    <nav class="mx-auto flex h-16 max-w-[1400px] items-center justify-between px-4 md:px-8">
      <a href="/b"><img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5 md:h-6" /></a>
      <a href="/b#talks" class="flex items-center gap-2 text-sm font-semibold text-soft-white/70 hover:text-soft-white"><Icon name="arrow-left" class="size-4" />All talks</a>
    </nav>
  </header>

  <main>
    <div class="mx-auto max-w-[1400px] px-4 md:px-8">
      <div class="rise aspect-video overflow-hidden rounded-2xl bg-panel-navy" style="--i:0">
        {talk.video
          ? <iframe class="size-full" src={`https://www.youtube-nocookie.com/embed/${talk.video.youtubeId}`} title={talk.title} allow="accelerometer; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
          : <div class="relative size-full bg-electric-blue">
              {talk.person.photo && <img src={talk.person.photo} alt="" class="size-full object-cover object-top mix-blend-luminosity grayscale contrast-125" />}
              <p class="absolute bottom-5 left-5 rounded-full bg-deep-navy/85 px-4 py-2 font-mono text-sm">The video is not online yet</p>
            </div>}
      </div>
    </div>

    <section class="mx-auto grid max-w-[1400px] gap-12 px-4 py-14 md:px-8 lg:grid-cols-12">
      <div class="lg:col-span-8">
        <p class="font-mono text-sm text-signal-yellow">{e.city} #{e.number}, {shortDate(e.date)}</p>
        <h1 class="mt-3 font-mono text-3xl font-semibold uppercase leading-[1.1] tracking-tight md:text-5xl">{talk.title}</h1>
        <p class="mt-8 text-xl leading-relaxed text-soft-white/85">{talk.summary}</p>
        {talk.takeaways.length > 0 && (
          <ul class="mt-10 space-y-4">
            {talk.takeaways.map((k) => (
              <li class="flex gap-4 text-lg leading-relaxed"><Icon name="arrow-right" class="mt-1.5 size-4 text-signal-yellow" /><span>{k}</span></li>
            ))}
          </ul>
        )}
        <Transcript talk={talk} class="mt-12 border-t border-soft-white/15 text-soft-white/85" />
      </div>
      <aside class="space-y-8 lg:col-span-4">
        <div class="flex items-center gap-4 rounded-2xl bg-panel-navy p-5">
          {talk.person.photo && <img src={talk.person.photo} alt="" class="size-16 rounded-full object-cover" />}
          <div>
            <p class="font-bold">{talk.person.name}</p>
            {talk.person.title && <p class="text-sm text-soft-white/60">{talk.person.title}</p>}
            {talk.speakerLinks.length > 0 && <p class="mt-1 flex gap-3 text-sm font-semibold">{talk.speakerLinks.map((l) => <a href={l.url} class="text-signal-yellow hover:underline">{l.label}</a>)}</p>}
          </div>
        </div>
        {talk.mentioned.length > 0 && (
          <div>
            <h2 class="font-mono text-sm text-soft-white/60">Mentioned in the talk</h2>
            <ul class="mt-3 space-y-2">
              {talk.mentioned.map((l) => <li><a href={l.url} class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 font-medium hover:bg-panel-navy">{l.label}<Icon name="arrow-up-right" class="size-4 text-soft-white/50" /></a></li>)}
            </ul>
          </div>
        )}
      </aside>
    </section>

    <section class="mx-auto max-w-[1400px] px-4 pb-24 md:px-8">
      <h2 class="font-mono text-2xl font-semibold uppercase">Watch next</h2>
      <div class="mt-6 grid gap-6 md:grid-cols-3">
        {next.map((t) => (
          <a href={`/b/talks/${t.id}`} class="group block">
            <div class="aspect-video overflow-hidden rounded-xl bg-electric-blue">
              {thumbnail(t)
                ? <img src={thumbnail(t)} alt="" class="size-full object-cover transition duration-700 group-hover:scale-[1.04]" loading="lazy" />
                : t.person.photo && <img src={t.person.photo} alt="" class="size-full object-cover object-top mix-blend-luminosity grayscale contrast-125" loading="lazy" />}
            </div>
            <p class="mt-3 font-bold group-hover:text-signal-yellow">{t.title}</p>
            <p class="text-sm text-soft-white/60">{t.person.name}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <footer class="border-t border-soft-white/10">
    <div class="mx-auto flex max-w-[1400px] flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-8">
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5" />
      <ul class="flex flex-wrap gap-6 text-sm font-semibold">{socials.map((s) => <li><a href={s.url} class="text-soft-white/70 hover:text-soft-white">{s.label}</a></li>)}</ul>
    </div>
  </footer>
</Shell>
