---
// Direction C, "The room": photo-led. The night itself sells the event:
// the crowd, how an evening runs, then the talks and the people.
import Shell from '../../layouts/Shell.astro';
import Icon from '../../components/Icon.astro';
import { nextEvent, past, talks, talksAt, speakers, socials, shortDate, longDate } from '../../lib/data';

const register = nextEvent?.luma?.url ?? 'https://luma.com/agnteng';
const night = [
  { time: '19:00', title: 'Doors open', body: 'Drinks, introductions and a room full of people who ship with agents.', photo: '/assets/photos/community/slide2-group-photo.jpg' },
  { time: '19:45', title: 'Three talks', body: 'Ten minutes each, on something real the speaker built or broke. No pitches.', photo: '/assets/photos/community/slide2-laptop-demo.jpg' },
  { time: '20:15', title: 'Questions', body: 'The audience asks, the speakers answer, and it carries on over drinks.', photo: '/assets/photos/events/lisbon-may2026.jpg' },
];
---
<Shell title="Agentic Engineering" class="bg-white text-ink">
  <section class="relative min-h-[100dvh] overflow-hidden bg-deep-navy text-soft-white">
    <img src="/assets/photos/events/lisbon-jul2026.webp" alt="The audience at an Agentic Engineering meetup in Lisbon" class="absolute inset-0 size-full object-cover" />
    <div class="absolute inset-0 bg-gradient-to-t from-deep-navy via-deep-navy/40 to-deep-navy/10"></div>

    <nav class="relative z-10 mx-auto flex h-16 max-w-7xl items-center justify-between px-4 md:px-8">
      <a href="/c"><img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5 md:h-6" /></a>
      <div class="flex items-center gap-6 text-sm font-semibold">
        <a href="#night" class="hidden hover:text-periwinkle md:block">The night</a>
        <a href="#talks" class="hidden hover:text-periwinkle md:block">Talks</a>
        <a href="#people" class="hidden hover:text-periwinkle md:block">Speakers</a>
        <a href="#involved" class="hidden hover:text-periwinkle md:block">Get involved</a>
      </div>
    </nav>

    <div class="relative z-10 mx-auto grid min-h-[calc(100dvh-4rem)] max-w-7xl items-end gap-10 px-4 pb-12 md:grid-cols-12 md:px-8 md:pb-16">
      <div class="md:col-span-7">
        <h1 class="rise text-5xl font-extrabold leading-[1.02] tracking-tight md:text-7xl" style="--i:0">People building with agents, in one room.</h1>
        <p class="rise mt-6 max-w-[44ch] text-lg leading-relaxed text-soft-white/80" style="--i:1">Agentic Engineering is a Lisbon meetup: three short talks, honest questions, good company.</p>
      </div>
      {nextEvent && (
        <div class="rise rounded-2xl bg-white p-6 text-ink shadow-[0_24px_80px_rgb(5_7_30/0.45)] md:col-span-5 md:justify-self-end md:w-full md:max-w-sm" style="--i:2">
          <p class="font-mono text-sm text-electric-blue">{nextEvent.city} #{nextEvent.number}</p>
          <p class="mt-2 text-2xl font-extrabold leading-tight">{longDate(nextEvent.date)}</p>
          <p class="mt-1 text-ink/60">19:00 at {nextEvent.venue}</p>
          <a href={register} class="mt-6 flex items-center justify-between rounded-xl bg-electric-blue px-5 py-3.5 font-semibold text-white transition hover:bg-bright-blue active:scale-[0.98]">
            Register on Luma<Icon name="arrow-right" class="size-5" />
          </a>
          <p class="mt-3 -rotate-2 text-center font-['Permanent_Marker'] text-lg text-electric-blue">see you there</p>
        </div>
      )}
    </div>
  </section>

  <section id="night" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <h2 class="max-w-[18ch] text-4xl font-extrabold leading-tight tracking-tight md:text-5xl">How a night goes</h2>
    <ol class="mt-14 grid gap-10 md:grid-cols-3 md:gap-6">
      {night.map((n, i) => (
        <li class:list={['reveal', i === 1 && 'md:mt-16', i === 2 && 'md:mt-32']}>
          <img src={n.photo} alt="" class="aspect-[4/5] w-full rounded-2xl object-cover" loading="lazy" />
          <p class="mt-5 font-mono text-sm text-electric-blue">{n.time}</p>
          <p class="mt-1 text-2xl font-extrabold">{n.title}</p>
          <p class="mt-2 max-w-[38ch] leading-relaxed text-ink/70">{n.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="talks" class="bg-canvas py-24 md:py-32">
    <div class="mx-auto max-w-7xl px-4 md:px-8">
      <h2 class="text-4xl font-extrabold tracking-tight md:text-5xl">What people have talked about</h2>
    </div>
    <ul class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 md:px-[max(2rem,calc((100vw-80rem)/2+2rem))] [scrollbar-width:thin]">
      {talks.map((t) => (
        <li class="w-[82vw] shrink-0 snap-start sm:w-[22rem]">
          <a href={`/c/talks/${t.id}`} class="group flex h-full flex-col rounded-2xl bg-white p-5 transition hover:-translate-y-1 hover:shadow-[0_18px_50px_rgb(28_29_46/0.12)]">
            <div class="flex items-center gap-3">
              {t.person.photo && <img src={t.person.photo} alt="" class="size-12 rounded-full object-cover" loading="lazy" />}
              <div><p class="font-semibold leading-tight">{t.person.name}</p><p class="text-sm text-ink/60">{shortDate(t.event.date)}</p></div>
            </div>
            <p class="mt-6 text-2xl font-extrabold leading-snug group-hover:text-electric-blue">{t.title}</p>
            <p class="mt-3 line-clamp-3 text-ink/70">{t.summary}</p>
            <p class="mt-auto flex items-center gap-2 pt-6 text-sm font-semibold text-electric-blue">
              {t.video ? <><Icon name="play-circle" class="size-5" />Watch the talk</> : <><Icon name="article" class="size-5" />Read the talk</>}
            </p>
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="people" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <h2 class="text-4xl font-extrabold tracking-tight md:text-5xl">On stage so far</h2>
    <ul class="mt-12 grid grid-cols-3 gap-3 sm:grid-cols-6">
      {speakers.map((s, i) => (
        <li class:list={['reveal', i % 2 === 1 && 'sm:translate-y-8']}>
          <a href={`/c/talks/${s.talks[0].id}`} class="group block">
            {s.photo && <img src={s.photo} alt="" class="aspect-[3/4] w-full rounded-2xl object-cover transition group-hover:-rotate-1" loading="lazy" />}
            <p class="mt-3 text-sm font-bold leading-tight">{s.name}</p>
            {s.title && <p class="text-xs text-ink/60">{s.title}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-7xl px-4 pb-24 md:px-8">
    <div class="grid gap-10 md:grid-cols-12">
      <img src="/assets/photos/events/lisbon-may2026.jpg" alt="A full room at an earlier Lisbon meetup" class="aspect-[4/3] w-full rounded-2xl object-cover md:col-span-6" loading="lazy" />
      <div class="md:col-span-6 md:self-center">
        <h2 class="text-4xl font-extrabold tracking-tight md:text-5xl">{past.length} nights in Lisbon so far</h2>
        <ol class="mt-8 space-y-3">
          {past.map((e) => (
            <li class="flex items-baseline justify-between gap-6 border-b border-line pb-3">
              <span class="font-semibold">#{e.number}, {shortDate(e.date)}</span>
              <span class="text-right text-ink/60">{e.venue}</span>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </section>

  <section id="involved" class="bg-electric-blue text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-24 md:grid-cols-12 md:px-8">
      <h2 class="text-4xl font-extrabold leading-tight tracking-tight md:col-span-6 md:text-5xl">Bring something you built.</h2>
      <div class="space-y-5 text-lg md:col-span-6">
        <p>Register for the next event and fill in the talk field. Ten minutes, real work, no pitches.</p>
        <p>Hosting or sponsoring? Find us on <a href="https://t.me/agntacc" class="underline underline-offset-4">Telegram</a> or read the <a href="https://sponsors.agnteng.com" class="underline underline-offset-4">sponsor deck</a>.</p>
        <a href={register} class="inline-flex items-center gap-2 rounded-xl bg-white px-6 py-3.5 font-semibold text-electric-blue transition hover:bg-soft-white active:scale-[0.98]">Register on Luma<Icon name="arrow-right" class="size-5" /></a>
      </div>
    </div>
  </section>

  <footer class="bg-deep-navy text-soft-white">
    <div class="mx-auto flex max-w-7xl flex-col gap-8 px-4 py-12 md:flex-row md:items-center md:justify-between md:px-8">
      <img src="/assets/logo/ae-wordmark-line-white.svg" alt="Agentic Engineering" class="h-5" />
      <ul class="flex flex-wrap gap-6 text-sm font-semibold">{socials.map((s) => <li><a href={s.url} class="hover:text-periwinkle">{s.label}</a></li>)}</ul>
    </div>
  </footer>
</Shell>
