---
import Shell from '../layouts/Shell.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import SpeakerCard from '../components/SpeakerCard.astro';
import { speakers } from '../lib/data';
---
<Shell title="Speakers | Agentic Engineering" description="Everyone who has given a talk at Agentic Engineering." class="bg-soft-white text-panel-navy">
  <SiteNav />
  <main id="main" class="mx-auto max-w-7xl px-4 py-16 md:px-8 md:py-24">
    <h1 class="font-sans text-4xl font-extrabold tracking-tight md:text-6xl">Speakers</h1>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
      {speakers.map((s, i) => <li><SpeakerCard speaker={s} index={i} /></li>)}
    </ul>
  </main>
  <SiteFooter />
</Shell>
