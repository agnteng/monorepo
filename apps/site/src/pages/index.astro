---
import { Image } from 'astro:assets';
import Shell from '../layouts/Shell.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TalkTile from '../components/TalkTile.astro';
import TintedPhoto from '../components/TintedPhoto.astro';
import SpeakerPhoto from '../components/SpeakerPhoto.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import DuotoneField from '@agnteng/brand/components/DuotoneField.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import Avatar from '@agnteng/brand/components/Avatar.astro';
import { nextEvent, past, talks, talksAt, coverAt, galleryPhoto, speakers, links, register, cardDate, shortDate, startTime, thumbnail, still as stillOf, eventSlug, eventName } from '../lib/data';
import { latestPosts } from '../lib/newsletter';

const posts = await latestPosts();
const [latest] = talks;
const recent = talks.slice(1, 7);
const still = stillOf(latest);
const night = [
  { time: '19:00', title: 'Doors open', body: 'Drinks and introductions. Most people here are shipping something with agents.', photo: galleryPhoto('2026-08-26', '04.jpg') },
  { time: '19:45', title: 'Three talks', body: 'Ten minutes each, on something the speaker built or broke. Product pitches get turned down.', photo: galleryPhoto('2026-11-11', '13.jpg') },
  { time: '20:15', title: 'Questions', body: 'Anyone can ask the speakers anything. It usually carries on over drinks.', photo: galleryPhoto('2026-11-11', '28.jpg') },
];
const fades = ['right', 'left', 'radial', 'up', 'down'] as const;
---
<Shell title="Agentic Engineering, Lisbon" class="bg-soft-white text-panel-navy">
  <section class="relative isolate min-h-[100dvh] overflow-hidden bg-deep-navy text-soft-white md:min-h-[88dvh]">
    <img src="/assets/photos/events/lisbon-aug2026-room.jpg" alt="" fetchpriority="high" class="absolute inset-0 size-full object-cover" />
    <!-- The dither rises from the bottom, under the copy, and clears over the crowd. -->
    <div class="absolute inset-0 [mask-image:linear-gradient(to_top,black_20%,transparent_70%)]">
    <DuotoneField
      client:load
      src="/assets/photos/events/lisbon-aug2026-room.jpg"
      animation="aurora"
      color="#1E2BE6"
      edge="#B5A6FF"
      bg="#05071E"
      cell={4}
      density={0.7}
      motion={40}
      contrast={1.25}
      edgeGlow={1}
      tone={0.7}
      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}
    />
    </div>
    <!-- Dark at the top (nav over the ceiling), clear across the crowd, navy under the copy. -->
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.8) 0%,rgba(5,7,30,0.15) 25%,rgba(5,7,30,0) 45%,rgba(5,7,30,0.45) 75%,#05071E 100%)"></div>
    <div class="pointer-events-none absolute inset-0 bg-deep-navy/50 md:hidden"></div>

    <SiteNav overlay />

    <div class="relative mx-auto grid min-h-[100dvh] max-w-7xl items-end gap-10 px-4 pt-24 pb-12 md:min-h-[88dvh] md:grid-cols-12 md:px-8 md:pb-16">
      <div class="relative isolate md:col-span-7">
        <!-- A soft scrim behind the copy, so it reads over the brightest dither cells. -->
        <div aria-hidden="true" class="pointer-events-none absolute -inset-x-12 -inset-y-14 -z-10 bg-[radial-gradient(closest-side,rgba(5,7,30,0.8),transparent)]"></div>
        <h1 class="rise font-sans text-4xl font-extrabold leading-[1.05] tracking-tight text-balance md:text-6xl" style="--i:0">A meetup for engineers building with AI agents.</h1>
        <p class="rise mt-6 max-w-[46ch] text-lg font-medium leading-relaxed text-soft-white" style="--i:1">Engineers show what they’ve shipped with AI agents: three ten-minute talks, then open questions. In {nextEvent?.city ?? 'Lisbon'}, in English.</p>
      </div>
      {nextEvent && (
        <div data-next-event class="rise rounded-2xl bg-white p-6 text-panel-navy shadow-xl shadow-deep-navy/40 md:col-span-5 md:w-full md:max-w-sm md:justify-self-end" style="--i:3">
          <span class="rounded-full bg-electric-blue px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-white">Next event</span>
          <p class="mt-5 font-sans text-2xl font-extrabold tracking-tight">{cardDate(nextEvent.date)}</p>
          {startTime(nextEvent) && <p class="mt-1 flex items-center gap-2 text-sm font-semibold text-panel-navy/70"><Icon name="Clock" size={15} class="text-electric-blue" />{startTime(nextEvent)}</p>}
          <Button variant="primary" href={register} class="js-register mt-6 w-full">{nextEvent.free ? 'Register – Free' : 'Register'}</Button>
        </div>
      )}
    </div>
  </section>

  <section id="talks" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <div class="flex flex-wrap items-end justify-between gap-6">
      <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-5xl">Latest talks</h2>
      <Button variant="outline" href="/talks">All talks</Button>
    </div>
    <a href={`/talks/${latest.id}`} class="group mt-12 grid gap-8 md:grid-cols-12 md:items-center">
      <div class="relative aspect-video overflow-hidden rounded-2xl bg-deep-navy md:col-span-7">
        {still
          ? <Image src={still} alt="" widths={[640, 1280]} sizes="(min-width: 768px) 58vw, 100vw" class="size-full object-cover transition duration-500 group-hover:scale-[1.02]" />
          : thumbnail(latest) && <img src={thumbnail(latest)} alt="" class="size-full object-cover transition duration-500 group-hover:scale-[1.02]" />}
        <span aria-hidden="true" class="absolute bottom-5 left-5"><span class="grid size-16 place-items-center rounded-full bg-electric-blue/90 shadow-xl shadow-deep-navy/40 transition group-hover:scale-110"><span class="ml-1 border-y-[11px] border-l-[18px] border-y-transparent border-l-white"></span></span></span>
      </div>
      <div class="md:col-span-5">
        <p class="font-mono text-[11px] uppercase tracking-wider text-electric-blue">{shortDate(latest.event.date)}</p>
        <h3 class="mt-3 font-sans text-3xl font-extrabold leading-tight tracking-tight group-hover:text-electric-blue md:text-4xl">{latest.title}</h3>
        <p class="mt-4 flex items-center gap-3 font-sans font-semibold"><Avatar name={latest.person.name} src={latest.person.photo} size={36} />{latest.person.name}</p>
        <p class="mt-5 line-clamp-4 leading-relaxed text-panel-navy/75">{latest.summary}</p>
      </div>
    </a>
    <ul class="mt-16 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}
    </ul>
  </section>

  <section id="speakers" class="border-t border-panel-navy/[0.08] bg-white">
    <div class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
      <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-5xl">Speakers</h2>
      <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
        {speakers.map((s, i) => (
          <li class="reveal">
            <a href={s.href} class="group block">
              {s.photo
                ? <SpeakerPhoto src={s.photo} index={i} class="rounded-2xl transition duration-300 group-hover:-translate-y-1" />
                : <div class="relative aspect-square overflow-hidden rounded-2xl bg-deep-navy transition duration-300 group-hover:-translate-y-1">
                      <Animation client:visible paused animation="drift" color="#1E2BE6" edge="#B5A6FF" cell={7} density={0.55} fade={fades[i % fades.length]} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
                      <span aria-hidden="true" class="absolute inset-0 grid place-items-center font-sans text-4xl font-extrabold text-soft-white [text-shadow:0_0_6px_#05071E,0_0_18px_#05071E]">{s.name.split(' ').map((w) => w[0]).join('').slice(0, 2)}</span>
                  </div>}
              <p class="mt-3 font-sans font-bold leading-tight">{s.name}</p>
              {s.title && <p class="mt-0.5 text-sm text-panel-navy/60">{s.title}</p>}
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-5xl">The format</h2>
    <ol class="mt-14 grid gap-12 md:grid-cols-3 md:gap-6">
      {night.map((n, i) => (
        <li class:list={['reveal', i === 1 && 'md:mt-16', i === 2 && 'md:mt-32']}>
          <TintedPhoto src={n.photo.img} alt={n.photo.alt} sizes="(min-width: 768px) 33vw, 100vw" class="aspect-[4/5] w-full rounded-2xl" />
          <p class="mt-5 font-mono text-sm font-semibold text-electric-blue">{n.time}</p>
          <p class="mt-1 font-sans text-2xl font-extrabold">{n.title}</p>
          <p class="mt-2 max-w-[38ch] leading-relaxed text-panel-navy/70">{n.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="events" class="mx-auto max-w-7xl border-t border-panel-navy/[0.08] px-4 py-20 md:px-8">
    <h2 class="font-sans text-2xl font-extrabold tracking-tight md:text-3xl">Previous meetups</h2>
    <ul class="mt-10 grid grid-cols-2 gap-x-4 gap-y-6 sm:grid-cols-3 lg:grid-cols-6">
      {past.map((e) => {
        const n = talksAt(e).length;
        const cover = coverAt(e);
        return (
          <li class="reveal">
            <a href={n ? `/events/${eventSlug(e)}` : e.luma?.url ?? links.luma} class="group block">
              {cover
                ? <TintedPhoto src={cover.img} alt={cover.alt} sizes="(min-width: 1024px) 16vw, (min-width: 640px) 33vw, 50vw" zoom class="aspect-[4/3] rounded-2xl" />
                : <div class="relative aspect-[4/3] overflow-hidden rounded-2xl bg-deep-navy"><Animation client:visible paused color="#1E2BE6" edge="#B5A6FF" cell={8} density={0.6} fade="radial" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} /></div>}
              <p class="mt-3 font-sans font-bold group-hover:text-electric-blue">{eventName(e)}</p>
              <p class="mt-0.5 text-sm text-panel-navy/60">{shortDate(e.date)}</p>
            </a>
          </li>
        );
      })}
    </ul>
  </section>

  <section id="newsletter" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <div class="grid gap-10 rounded-2xl bg-deep-navy p-8 text-soft-white md:grid-cols-12 md:p-12">
      <div class="md:col-span-5">
        <h2 class="font-sans text-3xl font-extrabold leading-tight tracking-tight md:text-4xl">Newsletter</h2>
        <p class="mt-4 max-w-[40ch] leading-relaxed text-soft-white/75">Notes from every night, the next date as soon as it's set, and the odd essay. On Substack.</p>
        <!-- Substack's own sign-up endpoint; it confirms in a new tab. -->
        <form action={`${links.substack}/api/v1/free?nojs=true`} method="post" target="_blank" class="mt-8 flex max-w-md flex-col gap-3 sm:flex-row">
          <label for="newsletter-email" class="sr-only">Email</label>
          <input id="newsletter-email" name="email" type="email" required autocomplete="email" placeholder="you@example.com" class="h-12 min-w-0 flex-1 rounded-full border border-white/15 bg-white/10 px-5 font-sans text-soft-white outline-none placeholder:text-soft-white/45 focus:border-periwinkle" />
          <button type="submit" class="h-12 rounded-full bg-electric-blue px-6 font-sans font-semibold text-white transition hover:bg-bright-blue">Subscribe</button>
        </form>
      </div>
      {posts.length > 0 && (
        <ul class="divide-y divide-white/10 md:col-span-7">
          {posts.map((p) => (
            <li>
              <a href={p.url} class="group flex items-start justify-between gap-6 py-5 first:pt-0">
                <div>
                  <p class="font-mono text-[11px] uppercase tracking-wider text-periwinkle">{shortDate(p.date)}</p>
                  <p class="mt-1.5 font-sans text-lg font-bold leading-snug group-hover:text-periwinkle">{p.title}</p>
                </div>
                <Icon name="ExternalLink" size={18} class="mt-6 shrink-0 text-soft-white/40" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section id="involved" class="bg-electric-blue text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-24 md:grid-cols-12 md:px-8">
      <h2 class="font-sans text-3xl font-extrabold leading-tight tracking-tight md:col-span-6 md:text-5xl">Get involved</h2>
      <div class="space-y-5 text-lg md:col-span-6">
        <p>To speak, register for the next event and fill in the talk field. Ten minutes, real work, no pitches.</p>
        <p>To host or sponsor a night, find us on <a href={links.telegram} class="underline underline-offset-4">Telegram</a> or read the <a href={links.sponsors} class="underline underline-offset-4">sponsor deck</a>.</p>
        <Button variant="secondary" href={register} class="js-register">Register on Luma</Button>
      </div>
    </div>
  </section>

  <SiteFooter />

</Shell>
