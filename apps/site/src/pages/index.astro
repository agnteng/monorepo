---
import Shell from '../layouts/Shell.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TalkTile from '../components/TalkTile.astro';
import DuotoneField from '@agnteng/brand/components/DuotoneField.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import Pill from '@agnteng/brand/components/Pill.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { nextEvent, past, talks, talksAt, speakers, links, longDate, shortDate, eventSlug, eventName } from '../lib/data';
import { latestPosts } from '../lib/newsletter';

const register = nextEvent?.luma?.url ?? links.luma;
const posts = await latestPosts(3);
const fades = ['right', 'left', 'radial', 'up', 'down', 'none'] as const;
const night = [
  { time: '19:00', title: 'Doors open', body: 'Drinks and introductions. Most people here are shipping something with agents.', photo: '/assets/photos/community/slide2-group-photo.jpg', alt: 'People talking before the talks start' },
  { time: '19:45', title: 'Three talks', body: 'Ten minutes each, on something the speaker built or broke. Product pitches get turned down.', photo: '/assets/photos/community/slide2-laptop-demo.jpg', alt: 'A speaker presenting with a live demo on screen' },
  { time: '20:15', title: 'Questions', body: 'The room asks, the speakers answer. It usually carries on over drinks.', photo: '/assets/photos/events/lisbon-may2026.jpg', alt: 'A full room listening during the Q&A' },
];
---
<Shell title="Agentic Engineering, Lisbon" class="bg-soft-white text-panel-navy">
  <section class="relative isolate min-h-[100dvh] overflow-hidden bg-deep-navy text-soft-white">
    <DuotoneField
      client:load
      src="/assets/photos/events/lisbon-jul2026.webp"
      animation="aurora"
      color="#1E2BE6"
      edge="#B5A6FF"
      bg="#05071E"
      cell={4}
      density={0.7}
      motion={40}
      contrast={1.25}
      edgeGlow={1}
      tone={0.7}
      style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }}
    />
    <div class="pointer-events-none absolute inset-0" style="background:linear-gradient(180deg,rgba(5,7,30,0.55) 0%,rgba(5,7,30,0) 30%,rgba(5,7,30,0.35) 60%,#05071E 100%)"></div>
    <!-- On narrow screens the headline sits mid-photo, over the brightest dither. -->
    <div class="pointer-events-none absolute inset-0 bg-deep-navy/50 md:hidden"></div>

    <SiteNav overlay />

    <div class="relative mx-auto grid min-h-[100dvh] max-w-7xl items-end gap-10 px-4 pt-24 pb-12 md:grid-cols-12 md:px-8 md:pb-16">
      <div class="md:col-span-7">
        <h1 class="rise font-mono text-4xl font-semibold leading-[1.05] tracking-tight md:text-6xl" style="--i:0">People building with agents, in one room.</h1>
        <p class="rise mt-6 max-w-[44ch] text-lg leading-relaxed text-soft-white/80" style="--i:1">A Lisbon meetup. Three ten-minute talks on what actually shipped, then questions.</p>
      </div>
      {nextEvent && (
        <div class="rise rounded-2xl bg-white p-6 text-panel-navy shadow-xl shadow-deep-navy/40 md:col-span-5 md:w-full md:max-w-sm md:justify-self-end" style="--i:2">
          <div class="flex items-center gap-3">
            <span class="rounded-full bg-electric-blue px-3 py-1 font-mono text-[11px] font-semibold uppercase tracking-wider text-white">{eventName(nextEvent)}</span>
            <span class="font-mono text-[11px] uppercase tracking-[0.2em] text-electric-blue">upcoming</span>
          </div>
          <div class="mt-5 flex flex-col gap-2.5 font-mono text-sm">
            <span class="flex items-center gap-2.5"><Icon name="Calendar" size={16} class="text-electric-blue" />{longDate(nextEvent.date)}, 19:00</span>
            <span class="flex items-center gap-2.5"><Icon name="MapPin" size={16} class="text-electric-blue" />{nextEvent.venue}</span>
          </div>
          <Button variant="primary" href={register} class="mt-6 w-full">Register on Luma</Button>
        </div>
      )}
    </div>
  </section>

  <section class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">How a night goes</h2>
    <ol class="mt-14 grid gap-12 md:grid-cols-3 md:gap-6">
      {night.map((n, i) => (
        <li class:list={['reveal', i === 1 && 'md:mt-16', i === 2 && 'md:mt-32']}>
          <img src={n.photo} alt={n.alt} class="aspect-[4/5] w-full rounded-2xl object-cover" loading="lazy" />
          <p class="mt-5 font-mono text-sm font-semibold text-electric-blue">{n.time}</p>
          <p class="mt-1 font-mono text-2xl font-semibold">{n.title}</p>
          <p class="mt-2 max-w-[38ch] leading-relaxed text-panel-navy/70">{n.body}</p>
        </li>
      ))}
    </ol>
  </section>

  <section id="talks" class="border-y border-panel-navy/[0.08] bg-white py-24 md:py-32">
    <div class="mx-auto flex max-w-7xl flex-wrap items-end justify-between gap-6 px-4 md:px-8">
      <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">The talks</h2>
      <Button variant="outline" href="/talks">All {talks.length} talks</Button>
    </div>
    <ul class="mt-12 flex snap-x snap-mandatory gap-5 overflow-x-auto px-4 pb-6 md:px-[max(2rem,calc((100vw-80rem)/2+2rem))]">
      {talks.map((t, i) => (
        <li class="w-[82vw] shrink-0 snap-start sm:w-[22rem]"><TalkTile talk={t} fade={fades[i % fades.length]} /></li>
      ))}
    </ul>
  </section>

  <section id="speakers" class="mx-auto max-w-7xl px-4 py-24 md:px-8 md:py-32">
    <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">Who has spoken</h2>
    <ul class="mt-12 grid grid-cols-2 gap-x-4 gap-y-8 sm:grid-cols-3 lg:grid-cols-6">
      {speakers.map((s, i) => (
        <li class:list={['reveal', i % 2 === 1 && 'lg:translate-y-8']}>
          <a href={`/talks/${s.talks[0].id}`} class="group block">
            {s.photo && <img src={s.photo} alt="" class="aspect-[3/4] w-full rounded-2xl object-cover transition duration-300 group-hover:-translate-y-1" loading="lazy" />}
            <p class="mt-3 font-sans font-bold leading-tight">{s.name}</p>
            {s.title && <p class="mt-0.5 text-sm text-panel-navy/60">{s.title}</p>}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section id="newsletter" class="mx-auto max-w-7xl px-4 pb-24 md:px-8 md:pb-32">
    <div class="grid gap-10 rounded-2xl bg-deep-navy p-8 text-soft-white md:grid-cols-12 md:p-12">
      <div class="md:col-span-5">
        <h2 class="font-mono text-3xl font-semibold leading-tight tracking-tight md:text-4xl">The newsletter</h2>
        <p class="mt-4 max-w-[40ch] leading-relaxed text-soft-white/70">Notes from every night, the next date as soon as it's set, and the odd essay. On Substack.</p>
        <Button variant="primary" href={`${links.substack}/subscribe`} class="mt-8">Subscribe</Button>
      </div>
      {posts.length > 0 && (
        <ul class="divide-y divide-white/10 md:col-span-7">
          {posts.map((p) => (
            <li>
              <a href={p.url} class="group flex items-start justify-between gap-6 py-5 first:pt-0">
                <div>
                  <p class="font-mono text-[11px] uppercase tracking-wider text-periwinkle">{shortDate(p.date)}</p>
                  <p class="mt-1.5 font-sans text-lg font-bold leading-snug group-hover:text-periwinkle">{p.title}</p>
                </div>
                <Icon name="ExternalLink" size={18} class="mt-6 shrink-0 text-soft-white/40" />
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>

  <section id="events" class="mx-auto max-w-7xl px-4 pb-24 md:px-8 md:pb-32">
    <div class="grid gap-10 md:grid-cols-12">
      <img src="/assets/photos/community/slide2-speaker-mic.jpg" alt="A speaker taking questions" class="aspect-[4/3] w-full rounded-2xl object-cover md:col-span-6" loading="lazy" />
      <div class="md:col-span-6 md:self-center">
        <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-5xl">{past.length} nights so far</h2>
        <ol class="mt-8">
          {past.map((e) => {
            const n = talksAt(e).length;
            return (
              <li>
                <a href={n ? `/events/${eventSlug(e)}` : e.luma?.url ?? links.luma} class="group flex items-center justify-between gap-6 border-b border-panel-navy/[0.08] py-4">
                  <span class="flex items-center gap-4">
                    <Pill>#{e.number}</Pill>
                    <span><span class="font-semibold group-hover:text-electric-blue">{shortDate(e.date)}</span><span class="block text-sm text-panel-navy/60">{e.venue}</span></span>
                  </span>
                  <span class="font-mono text-xs uppercase tracking-wider text-panel-navy/50">{n ? `${n} talks` : 'not filmed'}</span>
                </a>
              </li>
            );
          })}
        </ol>
      </div>
    </div>
  </section>

  <section id="involved" class="bg-electric-blue text-white">
    <div class="mx-auto grid max-w-7xl gap-10 px-4 py-24 md:grid-cols-12 md:px-8">
      <h2 class="font-mono text-3xl font-semibold leading-tight tracking-tight md:col-span-6 md:text-5xl">Bring something you built.</h2>
      <div class="space-y-5 text-lg md:col-span-6">
        <p>To speak, register for the next event and fill in the talk field. Ten minutes, real work, no pitches.</p>
        <p>To host or sponsor a night, find us on <a href={links.telegram} class="underline underline-offset-4">Telegram</a> or read the <a href={links.sponsors} class="underline underline-offset-4">sponsor deck</a>.</p>
        <Button variant="secondary" href={register}>Register on Luma</Button>
      </div>
    </div>
  </section>

  <SiteFooter />
</Shell>
