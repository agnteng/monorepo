---
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { events, talksAt, questionsAt, longDate, eventSlug, eventName, links, plural, type Event } from '../../lib/data';

export function getStaticPaths() {
  return events.filter((e) => talksAt(e).length).map((event) => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event: e } = Astro.props as { event: Event };
const talks = talksAt(e);
const questions = questionsAt(e);
---
<Shell title={`${eventName(e)}, ${longDate(e.date)} | Agentic Engineering`} description={`Agentic Engineering ${eventName(e)} at ${e.venue}: ${talks.map((t) => t.title).join(', ')}.`} class="bg-soft-white text-panel-navy">
  <section class="relative isolate overflow-hidden bg-deep-navy text-soft-white">
    <Animation client:load animation="aurora" color="#1E2BE6" edge="#ED4BA0" bg="#05071E" cell={6} density={0.6} motion={60} fade="left" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
    <SiteNav overlay />
    <div class="relative mx-auto max-w-7xl px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-24">
      <h1 class="rise font-mono text-5xl font-semibold tracking-tight md:text-7xl">{eventName(e)}</h1>
      <div class="rise mt-6 flex flex-col gap-2.5 font-mono text-sm text-soft-white/80" style="--i:1">
        <span class="flex items-center gap-2.5"><Icon name="Calendar" size={16} class="text-periwinkle" />{longDate(e.date)}</span>
        <span class="flex items-center gap-2.5"><Icon name="MapPin" size={16} class="text-periwinkle" />{e.venue}</span>
        <span class="flex items-center gap-2.5"><Icon name="Users" size={16} class="text-periwinkle" />{plural(talks.length, 'talk')}{questions.length > 0 && `, ${plural(questions.length, 'question')}`}</span>
      </div>
    </div>
  </section>

  <main class="mx-auto max-w-7xl px-4 md:px-8">
    <section class="py-16 md:py-24">
      <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-4xl">The talks</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{talks.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}</ul>
    </section>

    {questions.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <div class="md:col-span-4">
            <h2 class="font-mono text-3xl font-semibold tracking-tight md:text-4xl">What the room asked</h2>
            <p class="mt-4 max-w-[36ch] text-panel-navy/70">The Q&A after the talks, condensed from the recording.</p>
          </div>
          <div class="divide-y divide-panel-navy/10 md:col-span-8">
            {questions.map((q) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-sans text-lg font-bold leading-snug [&::-webkit-details-marker]:hidden">
                  <span>{q.question}</span>
                  <span class="mt-1 font-mono text-sm text-electric-blue transition group-open:rotate-45">+</span>
                </summary>
                <div class="space-y-4 pb-6">
                  {q.answers.map((a) => a.text.split('\n\n').map((para, i) => (
                    <p class="leading-relaxed text-panel-navy/80">{i === 0 && <span class="font-semibold text-panel-navy">{a.speaker}: </span>}{para}</p>
                  )))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="border-t border-panel-navy/[0.08] py-16">
      <div class="flex flex-wrap items-center justify-between gap-6">
        <p class="font-mono text-xl font-semibold">Next one is on Luma.</p>
        <div class="flex flex-wrap gap-3">
          {e.luma && <Button variant="outline" href={e.luma.url}>This event on Luma</Button>}
          <Button variant="primary" href={links.luma}>See upcoming events</Button>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter />
</Shell>
