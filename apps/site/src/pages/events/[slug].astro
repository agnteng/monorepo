---
import { getImage } from 'astro:assets';
import Shell from '../../layouts/Shell.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import TalkTile from '../../components/TalkTile.astro';
import Gallery from '../../components/Gallery.astro';
import Animation from '@agnteng/brand/components/Animation.tsx';
import DuotoneField from '@agnteng/brand/components/DuotoneField.tsx';
import Button from '@agnteng/brand/components/Button.astro';
import Icon from '@agnteng/brand/components/Icon.astro';
import { events, talksAt, questionsAt, photosAt, longDate, eventSlug, eventName, links, type Event } from '../../lib/data';

export function getStaticPaths() {
  return events.filter((e) => talksAt(e).length).map((event) => ({ params: { slug: eventSlug(event) }, props: { event } }));
}
const { event: e } = Astro.props as { event: Event };
const talks = talksAt(e);
const questions = questionsAt(e);
const photos = photosAt(e);
// The header dithers a wide shot of the room when the gallery has one.
const room = photos.find((p) => /room|audience/i.test(p.alt)) ?? photos[0];
const header = room && (await getImage({ src: room.img, width: 1600, format: 'webp' })).src;
---
<Shell title={`${eventName(e)}, ${longDate(e.date)} | Agentic Engineering`} description={`Agentic Engineering ${eventName(e)}: ${talks.map((t) => t.title).join(', ')}.`} class="bg-soft-white text-panel-navy">
  <section class="relative isolate overflow-hidden bg-deep-navy text-soft-white">
    {room
      ? <>
          <img src={header} alt="" class="absolute inset-0 size-full object-cover" />
          <div class="absolute inset-0 [mask-image:linear-gradient(to_right,black_25%,transparent_75%)]">
            <DuotoneField client:load src={header} animation="aurora" color="#1E2BE6" edge="#B5A6FF" bg="#05071E" cell={4} density={0.7} motion={40} contrast={1.25} edgeGlow={1} tone={0.7} style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />
          </div>
        </>
      : <Animation client:load animation="aurora" color="#1E2BE6" edge="#ED4BA0" bg="#05071E" cell={6} density={0.6} motion={60} fade="left" style={{ position: 'absolute', inset: 0, width: '100%', height: '100%' }} />}
    <!-- Text side darker, so the date reads over the dither. -->
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-r from-deep-navy/80 via-deep-navy/40 to-transparent"></div>
    <div class="pointer-events-none absolute inset-0 bg-gradient-to-b from-deep-navy/70 via-transparent to-deep-navy/60"></div>
    <SiteNav overlay />
    <div class="relative mx-auto max-w-7xl px-4 pt-32 pb-16 md:px-8 md:pt-40 md:pb-24">
      <h1 class="rise font-sans text-5xl font-extrabold tracking-tight md:text-7xl">{eventName(e)}</h1>
      <p class="rise mt-6 flex items-center gap-2.5 font-sans text-sm font-medium text-soft-white" style="--i:1"><Icon name="Calendar" size={16} class="text-periwinkle" />{longDate(e.date)}</p>
    </div>
  </section>

  <main class="mx-auto max-w-7xl px-4 md:px-8">
    <section class="py-16 md:py-24">
      <h2 class="font-sans text-3xl font-extrabold tracking-tight md:text-4xl">Talks</h2>
      <ul class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">{talks.map((t, i) => <li class="reveal"><TalkTile talk={t} index={i} /></li>)}</ul>
    </section>

    {photos.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] pb-16 md:pb-24">
        <Gallery photos={photos} />
      </section>
    )}

    {questions.length > 0 && (
      <section class="border-t border-panel-navy/[0.08] py-16 md:py-24">
        <div class="grid gap-10 md:grid-cols-12">
          <h2 class="font-sans text-3xl font-extrabold tracking-tight md:col-span-4 md:text-4xl">Q&A</h2>
          <div class="divide-y divide-panel-navy/10 md:col-span-8">
            {questions.map((q) => (
              <details class="group py-1">
                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 py-4 font-sans text-lg font-bold leading-snug [&::-webkit-details-marker]:hidden">
                  <span>{q.question}</span>
                  <span class="mt-1 font-mono text-sm text-electric-blue transition group-open:rotate-45">+</span>
                </summary>
                <div class="space-y-4 pb-6">
                  {q.answers.map((a) => a.text.split('\n\n').map((para, i) => (
                    <p class="leading-relaxed text-panel-navy/80">{i === 0 && <span class="font-semibold text-panel-navy">{a.speaker}: </span>}{para}</p>
                  )))}
                </div>
              </details>
            ))}
          </div>
        </div>
      </section>
    )}

    <section class="flex flex-wrap gap-3 border-t border-panel-navy/[0.08] py-16">
      {e.recap && <Button variant="outline" href={e.recap}>Read the recap</Button>}
      {e.luma && <Button variant="outline" href={e.luma.url}>This event on Luma</Button>}
      <Button variant="primary" href={links.luma}>See upcoming events</Button>
    </section>
  </main>
  <SiteFooter />
</Shell>
