---
import '../styles/site.css';
interface Props { title: string; description?: string; class?: string }
const { title, description = 'Agentic Engineering: a Lisbon meetup for people building software, infrastructure and companies with AI agents.', class: cls } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <script is:inline>
      // A visitor who paused the animation keeps it paused (the footer's switch).
      try { if (localStorage.getItem('motion') === 'off') document.documentElement.dataset.motion = 'off'; } catch {}
    </script>
    <link rel="icon" type="image/svg+xml" href="/assets/logo/ae-icon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Kode+Mono:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class:list={['font-sans', cls]}>
    <a href="#main" class="sr-only rounded-full bg-white px-5 py-3 font-semibold text-panel-navy shadow-lg focus:not-sr-only focus:fixed focus:px-5 focus:py-3 focus:left-4 focus:top-4 focus:z-50">Skip to content</a>
    <slot />
  </body>
</html>
